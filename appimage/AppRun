#!/bin/bash
# AppRun – ProtonVPN Qt App AppImage launcher.
#
# The AppImage runtime sets $APPIMAGE (path to the .AppImage file) and
# $APPDIR (mount point of the squashfs filesystem) before executing this
# script.  We provide a fallback so the extracted AppDir can also be
# tested directly without running it through the AppImage runtime.

if [[ -z "${APPDIR}" ]]; then
    APPDIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
fi
export APPDIR

# ── ProtonVPN CLI ─────────────────────────────────────────────────────────────
# Add the bundled CLI launcher to the front of PATH so the Qt app resolves
# "protonvpn" to the version we shipped, not a system install.
export PATH="${APPDIR}/usr/share/protonvpn:${PATH}"

# ── Qt runtime ────────────────────────────────────────────────────────────────
# No trailing ":" when LD_LIBRARY_PATH is unset: an empty entry means the current directory.
export LD_LIBRARY_PATH="${APPDIR}/usr/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

# Bundled Qt plugins take priority.  System Qt6 plugin paths are appended so
# the host desktop's style plugins (e.g. Breeze on KDE Plasma) are also
# visible.  On desktops without Breeze the app falls back to Fusion as normal.
# The Debian/Ubuntu multiarch path follows the host CPU (x86_64 or aarch64).
export QT_PLUGIN_PATH="${APPDIR}/usr/plugins:/usr/lib/qt6/plugins:/usr/lib/$(uname -m)-linux-gnu/qt6/plugins:/usr/lib64/qt6/plugins${QT_PLUGIN_PATH:+:${QT_PLUGIN_PATH}}"

# Qt reports QT_QPA_PLATFORM_PLUGIN_PATH in the "not found" warning and uses
# it as the primary search path for platform plugins (wayland, xcb, etc.).
# Point it exclusively at the bundled platforms dir so the version-matched
# libqwayland.so (bundled from the CI's qt6-wayland package) is found.
export QT_QPA_PLATFORM_PLUGIN_PATH="${APPDIR}/usr/plugins/platforms"


# ── Launch ────────────────────────────────────────────────────────────────────
exec "${APPDIR}/usr/bin/proton_vpn_qt" "$@"
