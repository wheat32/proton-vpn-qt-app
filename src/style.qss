QWidget {
    background-color: #1a1a2e;
    color: #eaeaea;
    font-family: "Inter", "Noto Sans", "Segoe UI", sans-serif;
    font-size: 13px;
}

QLabel {
    background-color: transparent;
}

QWidget#sidebar {
    background-color: #131320;
    border-right: 1px solid #3a3a55;
    padding: 0;
}

/* Painted here, not by the Qt style: Breeze draws a frame line as a faint
   separator and Fusion (the AppImage's style) at full strength. */
QFrame#sidebarDivider {
    border: none;
    background-color: #202036;
}

QToolButton#navButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
}
QToolButton#navButton:hover {
    background-color: #2d2d4a;
}
QToolButton#navButton:checked {
    background-color: #3a2d7a;
}

QToolButton#logoButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px;
}
QToolButton#logoButton:hover {
    background-color: #2d2d4a;
}
QToolButton#logoButton:checked {
    background-color: #3a2d7a;
}

QWidget#loginCard {
    background-color: #25253d;
    border-radius: 12px;
    border: 1px solid #3a3a55;
}

QLabel#sectionTitle {
    font-size: 18px;
    font-weight: bold;
    color: #eaeaea;
}

QLabel#fieldLabel {
    color: #9999bb;
    font-size: 12px;
}

QLabel#errorLabel,
QAbstractScrollArea#errorLabel {
    color: #ff6b6b;
    background-color: rgba(214, 63, 63, 0.1);
    border: 1px solid #d63f3f;
    border-radius: 6px;
    padding: 8px;
}

QLabel#timerLabel {
    font-size: 16px;
    color: #9999bb;
    font-family: "Courier New", "DejaVu Sans Mono", monospace;
}

QLabel#infoLabel {
    color: #9999bb;
    font-size: 12px;
}

QLabel#signOutHintLabel {
    color: #c8a040;
    font-size: 12px;
    background-color: rgba(245, 166, 35, 0.08);
    border: 1px solid rgba(245, 166, 35, 0.35);
    border-radius: 6px;
    padding: 8px 12px;
}

QLineEdit#inputField {
    background-color: #1a1a2e;
    border: 1px solid #3a3a55;
    border-radius: 6px;
    padding: 8px 12px;
    color: #eaeaea;
    selection-background-color: #6d4aff;
}
QLineEdit#inputField:focus {
    border-color: #6d4aff;
}
/*  The field of a QInputDialog (Custom DNS from the quick settings), drawn
    like the app's own fields rather than by the Qt style.  */
QInputDialog QLineEdit {
    background-color: #1a1a2e;
    border: 1px solid #3a3a55;
    border-radius: 6px;
    padding: 6px 10px;
    color: #eaeaea;
    selection-background-color: #6d4aff;
}
QInputDialog QLineEdit:focus {
    border-color: #6d4aff;
}

QFrame#locationPicker {
    background-color: transparent;
}
QFrame#locationPickerHeader {
    background-color: #1a1a2e;
    border: 1px solid #3a3a55;
    border-radius: 8px;
}
QFrame#locationPickerHeader:hover {
    border-color: #6d4aff;
}
QLabel#locationPickerTop {
    color: #9999bb;
    font-size: 10px;
}
QLabel#locationPickerBottom {
    color: #eaeaea;
    font-size: 13px;
    font-weight: bold;
}
QLabel#locationPickerChevron {
    color: #9999bb;
    font-size: 12px;
}
QFrame#locationPickerPopup {
    background-color: #1a1a2e;
    border: 1px solid #3a3a55;
    border-top: none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
QListWidget#locationPickerList {
    background-color: transparent;
    border: none;
    outline: none;
}
QListWidget#locationPickerList::item {
    border-bottom: 1px solid #2d2d4a;
}
QListWidget#locationPickerList::item:selected,
QListWidget#locationPickerList::item:selected:!active {
    background-color: #2d2d4a;
}
QListWidget#locationPickerList::item:hover {
    background-color: #2d2d4a;
}
/*  Picker dropdown row under the mouse (PickerBase::setHoveredRow). Matches the
    row only, never the labels and buttons inside it, so the translucent color
    is painted once.  */
QListWidget#locationPickerList QWidget[hovered="true"] {
    background-color: rgba(109, 74, 255, 60);
}

/*  Countries page: the "Fastest server" row at the top of a city list  */
QWidget#cityRow[fastest="true"] {
    background-color: rgba(109, 74, 255, 40);
}

QLabel#locationPickerItemLabel {
    color: #eaeaea;
    font-size: 13px;
}

QPushButton#primaryButton {
    background-color: #6d4aff;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 24px;
    font-weight: bold;
    font-size: 14px;
    min-width: 140px;
}
QPushButton#primaryButton:hover {
    background-color: #5a3de0;
}
QPushButton#primaryButton:disabled {
    background-color: #3a3a55;
    color: #666680;
}

/*  Also applied to the buttons Qt creates inside standard dialogs
    (QMessageBox, QDialogButtonBox), which the app cannot give an object
    name; without a rule they would be drawn by the native style.  */
QPushButton#secondaryButton,
QDialogButtonBox QPushButton {
    background-color: transparent;
    color: #9999bb;
    border: 1px solid #3a3a55;
    border-radius: 6px;
    padding: 4px 12px;
}
QPushButton#secondaryButton:hover,
QDialogButtonBox QPushButton:hover {
    background-color: #2d2d4a;
    color: #eaeaea;
}

/*  Main button of a dialog (Close, Got It!, Download). Mirrors how Breeze
    draws a dialog's default button, so builds running under Fusion (the
    AppImage) look the same. A standard dialog's default button gets it too.  */
QPushButton#dialogButton,
QDialogButtonBox QPushButton:default {
    background-color: rgba(109, 74, 255, 0.2);
    color: palette(button-text);
    border: 1px solid #5847a9;
    border-radius: 4px;
    padding: 4px 12px;
}
QPushButton#dialogButton:hover,
QDialogButtonBox QPushButton:default:hover {
    background-color: rgba(109, 74, 255, 0.32);
    border-color: #6d4aff;
}
QPushButton#dialogButton:pressed,
QDialogButtonBox QPushButton:default:pressed {
    background-color: rgba(109, 74, 255, 0.42);
}

QDialogButtonBox QPushButton {
    min-width: 64px;
}

/*  No stock icons (Fusion's check mark on OK, for one) on the buttons of
    standard dialogs: Breeze draws none, and the AppImage, which runs under
    Fusion, should look the same.  */
QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}

/* Floating overlay variant – same look as secondaryButton but with a solid
   page-color background so content scrolling underneath is hidden. */
QPushButton#refreshOverlayButton {
    background-color: #1a1a2e;
    color: #9999bb;
    border: 1px solid #3a3a55;
    border-radius: 6px;
    padding: 4px 12px;
}
QPushButton#refreshOverlayButton:hover {
    background-color: #2d2d4a;
    color: #eaeaea;
}
QPushButton#refreshOverlayButton:disabled {
    color: #666680;
    border-color: #2d2d4a;
}

QPushButton#leaveVpnOnButton {
    background-color: transparent;
    color: palette(window-text);
    border: 1px solid palette(window-text);
    border-radius: 6px;
    padding: 4px 12px;
}
QPushButton#leaveVpnOnButton:hover {
    background-color: rgba(128, 128, 128, 0.15);
}

QPushButton#dangerButton {
    background-color: transparent;
    color: #ff6b6b;
    border: 1px solid #d63f3f;
    border-radius: 6px;
    padding: 10px 24px;
    font-weight: bold;
}
QPushButton#dangerButton:hover {
    background-color: rgba(214, 63, 63, 0.15);
}
/*  Disabled, e.g. a quick settings copy with nothing to clear.  */
QPushButton#dangerButton:disabled {
    color: #6a6a85;
    border-color: #3a3a55;
}

/*  A Settings action that is not destructive (Restore, the auto-connect
    server): the Clear buttons' shape, in the accent color.  */
QPushButton#accentButton {
    background-color: transparent;
    color: #ab8fff;
    border: 1px solid #6d4aff;
    border-radius: 6px;
    padding: 10px 24px;
    font-weight: bold;
}
QPushButton#accentButton:hover {
    background-color: rgba(109, 74, 255, 0.15);
}
/*  Disabled, e.g. the auto-connect server for a free account.  */
QPushButton#accentButton:disabled {
    color: #6a6a85;
    border-color: #3a3a55;
}

QPushButton#iconButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
}
QPushButton#iconButton:hover {
    background-color: #2d2d4a;
}

QToolButton#starButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
}
QToolButton#starButton:hover {
    background-color: #2d2d4a;
    border: 1px solid #6d4aff;
    border-radius: 3px;
}

QListWidget#serverList {
    background-color: #1a1a2e;
    border: 1px solid #3a3a55;
    border-radius: 6px;
    outline: none;
}
QListWidget#serverList::item {
    padding: 8px 12px;
    border-bottom: 1px solid #2d2d4a;
}
QListWidget#serverList::item:selected {
    background-color: #3a2d7a;
    color: white;
}
QListWidget#serverList::item:hover {
    background-color: #2d2d4a;
}

QLabel#listHeader {
    font-size: 12px;
    font-weight: bold;
    color: #9999bb;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 0;
}

QWidget#infoCard {
    background-color: #25253d;
    border-radius: 8px;
    border: 1px solid #3a3a55;
}

QWidget#infoRow {
    background-color: transparent;
}

QLabel#infoKey {
    color: #9999bb;
}

QLabel#infoValue {
    color: #eaeaea;
    font-weight: bold;
}

/*  Painted here instead of by the Qt style, so the line looks the same under
    Breeze (native builds, Flatpak) and Fusion (AppImage). The color is what
    Breeze drew for "color: #3a3a55": 20% of it over the #1a1a2e window. The
    window-colored top and bottom borders keep the line 1px thick in the
    middle of the 3px frame.  */
QFrame#divider {
    border: none;
    border-top: 1px solid #1a1a2e;
    border-bottom: 1px solid #1a1a2e;
    background-color: #202036;
}

QSplitter::handle {
    background-color: #3a3a55;
    width: 1px;
}

QToolButton#accordionHeader {
    background-color: #1a1a2e;
    border: none;
    border-bottom: 1px solid #2d2d4a;
    color: #eaeaea;
    text-align: left;
    padding: 0 12px;
    font-size: 13px;
}
QToolButton#accordionHeader:hover {
    background-color: #2d2d4a;
}

/* QScrollArea's internal viewport widget doesn't inherit the app's palette
   the way a normal QWidget does under Fusion, so it falls back to the
   style's own default rendering unless given an explicit background. */
QScrollArea {
    background: transparent;
    border: none;
}
QScrollArea > QWidget {
    background: transparent;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: #1a1a2e;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #3a3a55;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #6d4aff;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
/*  Horizontal ones the same way (the Properties window's server table), and
    no stippled page area under either: Fusion, the AppImage's style, draws
    one where these rules leave it.  */
QScrollBar:horizontal {
    background: #1a1a2e;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: #3a3a55;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #6d4aff;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

QFrame#numberSpinner {
    background-color: #1a1a2e;
    border: 1px solid #3a3a55;
    border-radius: 6px;
}
QFrame#numberSpinnerButtons {
    background-color: transparent;
    border-left: 1px solid #3a3a55;
}
QLineEdit#numberSpinnerDisplay {
    background-color: transparent;
    color: #eaeaea;
    border: none;
    padding: 2px 4px;
    selection-background-color: #6d4aff;
}
QPushButton#numberSpinnerBtnUp,
QPushButton#numberSpinnerBtnDown {
    background-color: #25253d;
    border: none;
    padding: 0;
    margin: 0;
    min-height: 0;
}
QPushButton#numberSpinnerBtnUp {
    border-top-right-radius: 5px;
}
QPushButton#numberSpinnerBtnDown {
    border-bottom-right-radius: 5px;
}
QPushButton#numberSpinnerBtnUp:hover,
QPushButton#numberSpinnerBtnDown:hover {
    background-color: #3a3a55;
}
QPushButton#numberSpinnerBtnUp:disabled,
QPushButton#numberSpinnerBtnDown:disabled {
    background-color: #1e1e32;
}

QFrame#toastNotification {
    background-color: #1c3a28;
    border: 1px solid #2d6a4f;
    border-radius: 8px;
}
QFrame#toastNotification QLabel {
    color: #6fcf97;
    background: transparent;
    border: none;
}
QPushButton#toastCloseBtn {
    color: #6fcf97;
    background: transparent;
    border: none;
    font-weight: bold;
}
QPushButton#toastCloseBtn:hover {
    color: #a8e6c8;
}

QLabel#upgradeLabel {
    color: #aaaaaa;
    font-size: 9pt;
    padding: 4px 0px;
}
QLabel#upgradeLabel a {
    color: #7B61FF;
}

/*  Plus Members Only divider (VPN settings tab)  */
QLabel#plusDividerLabel {
    color: #7B61FF;
    font-size: 9pt;
    font-weight: bold;
    background-color: transparent;
}
/*  Painted like QFrame#divider, for the same reason  */
QFrame#plusDividerLine {
    border: none;
    border-top: 1px solid #1a1a2e;
    border-bottom: 1px solid #1a1a2e;
    background-color: #202036;
}

/*  App-tab section headers  */
QLabel#appSectionHeader {
    color: #c0b8e8;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    background-color: transparent;
}
QFrame#appSectionDivider {
    color: #3a3a55;
    background-color: #3a3a55;
    max-height: 1px;
    border: none;
    margin: 8px 0px 0px 0px;
}

/*  About nav row (clickable settings-style row)  */
QWidget#appNavRow:hover {
    background-color: #2d2d4a;
    border-radius: 8px;
}
/* Make child QWidgets transparent so the hover background shows through */
QWidget#appNavRow QWidget {
    background-color: transparent;
}

/*  Forwarded-port button group  */
/* Left segment: port number label */
QLabel#portValueLabel {
    border: 1px solid palette(mid);
    border-right: none;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    background: transparent;
    padding: 4px 12px;
    font-weight: bold;
}
/* Right segment: clipboard copy button */
QPushButton#portCopyBtn {
    border: 1px solid palette(mid);
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    background: transparent;
    padding: 0px;
}
QPushButton#portCopyBtn:hover {
    border-color: palette(highlight);
    background: rgba(255,255,255,20);
}
QPushButton#portCopyBtn:pressed {
    background: rgba(255,255,255,40);
}

/*  Picker Drawer  */
QFrame#pickerDrawer {
    background-color: #14142a;
    border-top: 1px solid #3a3a55;
    border-right: 1px solid #3a3a55;
    border-top-right-radius: 8px;
}

QFrame#drawerNotch {
    background-color: #25253d;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border: 1px solid #3a3a55;
    border-left: none;
}

QFrame#drawerNotch:hover {
    background-color: #2d2d4a;
}

/*  Tabs (Settings page): Fusion has no built-in Breeze-like tab rendering,
    so this is defined explicitly rather than left to the active QStyle. */
QTabWidget::pane {
    background-color: #1a1a2e;
    border: 1px solid #3a3a55;
    border-radius: 6px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    top: -1px;
}
QTabWidget::tab-bar {
    left: 0px;
    alignment: left;
}
QTabBar::tab {
    background-color: transparent;
    color: #9999bb;
    border: none;
    padding: 6px 16px 5px 16px;
}
QTabBar::tab:selected {
    background-color: #1a1a2e;
    color: #eaeaea;
    font-weight: bold;
    border: 1px solid #3a3a55;
    border-bottom: none;
    border-top: 2px solid #6d4aff;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 4px 15px 5px 15px;
}
QTabBar::tab:hover:!selected {
    background-color: #1c1c34;
    color: #eaeaea;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

/*  Menus (the tray menu, and the Settings page's right-click menu): drawn
    here like the combo box dropdowns below, so they look the same under
    every Qt style, with an outlined box for the checkable items. Square
    cornered: a menu's window is not see-through, so rounded corners would
    leave dark specks.  */
QMenu {
    background-color: #25253d;
    color: #eaeaea;
    border: 1px solid #3a3a55;
    padding: 4px;
}
QMenu::item {
    padding: 6px 14px 6px 30px;
    border: 1px solid transparent;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #3a335d;
    border-color: #664f9d;
}
QMenu::item:disabled {
    color: #6a6a85;
}
QMenu::separator {
    height: 1px;
    margin: 4px 6px;
    background-color: #3a3a55;
}
QMenu::indicator {
    width: 14px;
    height: 14px;
    left: 9px;
}
QMenu::indicator:non-exclusive:unchecked {
    border: 1px solid #555570;
    border-radius: 3px;
}
QMenu::indicator:non-exclusive:checked {
    border: 1px solid #6d4aff;
    border-radius: 3px;
    background-color: #6d4aff;
    image: url(:/assets/check-white.svg);
}

QComboBox {
    background-color: #25253d;
    color: #eaeaea;
    border: 1px solid #3a3a55;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 22px;
    combobox-popup: 0;
}
QComboBox:hover {
    border-color: #6d4aff;
}
QComboBox:focus {
    border: 1px solid #6d4aff;
}
/*  The popup and its items are drawn entirely by these rules (combo boxes get
    a QStyledItemDelegate, see StyledComboBox), so they look the
    same under Breeze (native builds, Flatpak) and Fusion (AppImage). They copy
    Breeze's look: 30px items with a rounded, outlined highlight. Breeze's first
    item is 1px taller, hence the extra top padding, and the -1px item padding
    lines the text up with Breeze's.  */
QComboBox QAbstractItemView {
    background-color: #25253d;
    color: #eaeaea;
    border: 1px solid #3a3a55;
    border-radius: 6px;
    outline: none;
    padding: 5px 4px 4px 4px;
}
QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 0px 0px 0px -1px;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #eaeaea;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #3a335d;
    border-color: #664f9d;
    color: #eaeaea;
}
QComboBox:disabled {
    color: #555570;
    background-color: #1e1e32;
    border-color: #2a2a40;
}
QComboBox::drop-down {
    background: transparent;
    border: none;
}
QComboBox::drop-down:disabled {
    background: transparent;
    border: none;
}
QComboBox::down-arrow {
    image: url(:/assets/chevron-down-light.svg);
    width: 12px;
    height: 12px;
}
QComboBox::down-arrow:disabled {
    image: url(:/assets/chevron-down-light.svg);
    width: 12px;
    height: 12px;
    opacity: 0.3;
}

/*  ==========================================================================
    Colors that used to live in inline setStyleSheet() calls in C++.
    Keeping them here means the light theme can override them; hardcoding
    them in code made several of them illegible in the light theme.
    ========================================================================== */

/*  VPN status label - color follows the "vpnState" dynamic property  */
QLabel#vpnStatusLabel {
    font-size: 16pt;
    font-weight: bold;
    letter-spacing: 1px;
    color: #9999bb;
}
QLabel#vpnStatusLabel[vpnState="connected"]     { color: #1a9c5b; }
QLabel#vpnStatusLabel[vpnState="disconnected"]  { color: #888888; }
QLabel#vpnStatusLabel[vpnState="transitioning"] { color: #f5a623; }
QLabel#vpnStatusLabel[vpnState="error"]         { color: #d63f3f; }

/*  Secondary description text under a setting name  */
QLabel#settingsDesc                  { color: #888888; }
QLabel#settingsDesc[disabled="true"] { color: #444444; }
QLabel#infoKey[disabled="true"]      { color: #555555; }

/*  Accent rows: "Fastest server" entries and picker actions  */
QLabel#locationPickerItemLabel[fastest="true"] { color: #ab8fff; }
QLabel#cityLabel[fastest="true"] { color: #ab8fff; background-color: transparent; }
QLabel#locationPickerItemLabel[action="true"] { color: #888888; }

/*  Location picker dimmed for free accounts (no location choice)  */
QLabel#locationPickerTop[dimmed="true"],
QLabel#locationPickerBottom[dimmed="true"] { color: #666677; }

/*  Account plan value  */
QLabel#infoValue[plan="free"] { color: #aaaaaa; font-weight: normal; }
QLabel#infoValue[plan="plus"] { color: #7B61FF; font-weight: bold; }

/*  ==========================================================================
    VPN page background globe
    ========================================================================== */

/*  Every plain container on the VPN page lets the globe show through. Widgets
    with background rules of their own (pickers, drawer, banners, buttons) keep
    them: those rules are more specific than this one.  */
VpnPage QWidget {
    background-color: transparent;
}

/*  Except combo boxes (the quick settings'), which keep the colors they have
    everywhere else. Their dropdown is a window of its own and would otherwise
    show black wherever nothing paints it. The QFrame rule restores the
    dropdown's frame; the item view rule after it wins for the view itself.  */
VpnPage QComboBox {
    background-color: #25253d;
}
VpnPage QComboBox QFrame {
    background-color: #1a1a2e;
}
VpnPage QComboBox QAbstractItemView {
    background-color: #25253d;
}

/*  The quick settings' cards let the globe show through. Their dividers are a
    plain line: the window-colored edges QFrame#divider has elsewhere would
    show as bands over the globe.  */
QuickSettingsPanel QWidget#infoCard {
    background-color: rgba(37, 37, 61, 0.6);
}
QuickSettingsPanel QFrame#divider,
QuickSettingsPanel QFrame#plusDividerLine {
    border: none;
    min-height: 1px;
    max-height: 1px;
    background-color: rgba(58, 58, 85, 0.7);
}
/*  Its copies of the Settings page's buttons are as tall as its dropdowns,
    so every row lines up.  */
QuickSettingsPanel QPushButton#dangerButton,
QuickSettingsPanel QPushButton#accentButton,
QuickSettingsPanel QPushButton#secondaryButton {
    padding: 6px 16px;
}

/*  Text over the globe sits on a partly transparent backdrop to stay legible.
    Only on the VPN page: other pages use infoLabel too, with no globe behind.  */
VpnPage QLabel#vpnStatusLabel,
VpnPage QLabel#timerLabel,
VpnPage QLabel#infoLabel {
    background-color: rgba(26, 26, 46, 0.72);
    border-radius: 8px;
    padding: 2px 12px;
}
QLabel#infoLabel[empty="true"] {
    background-color: transparent;
}
/*  The error box and the sign-out hint below it, in the colors their tints
    give over the plain window but nearly opaque: tinted only lightly, they
    let the globe's land show through their text and links.  */
VpnPage QLabel#errorLabel {
    background-color: rgba(45, 30, 48, 0.9);
}
VpnPage QLabel#signOutHintLabel {
    background-color: rgba(44, 37, 45, 0.9);
}

/*  ==========================================================================
    Countries page beside the home page (the split view)
    ========================================================================== */

/*  Styled like the home page's quick settings on the other side: a section
    header for its title, and its lists in cards.  */
CountriesPage[splitView="true"] QLabel#sectionTitle {
    color: #c0b8e8;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}
CountriesPage[splitView="true"] QListWidget#serverList,
CountriesPage[splitView="true"] QScrollArea#countriesAccordion {
    background-color: #25253d;
    border: 1px solid #3a3a55;
    border-radius: 8px;
}
/*  The card's color rather than transparent, which leaves the header to the
    Qt style's own button fill.  */
CountriesPage[splitView="true"] QToolButton#accordionHeader {
    background-color: #25253d;
}
CountriesPage[splitView="true"] QToolButton#accordionHeader:hover {
    background-color: #2d2d4a;
}

/*  Its countries are a grid of cards, each a flag over its name (see
    CountriesPage::updateCountriesListMode()). The list itself is only the
    space the cards sit in.  */
QListWidget#countryGrid {
    background-color: transparent;
    border: none;
    outline: none;
    font-size: 12px;
}
QListWidget#countryGrid::item {
    margin: 4px;
    padding: 10px 6px 6px 6px;
    color: #eaeaea;
    background-color: #25253d;
    border: 1px solid #3a3a55;
    border-radius: 8px;
}
QListWidget#countryGrid::item:hover {
    background-color: #2d2d4a;
    border-color: #6d4aff;
}
QListWidget#countryGrid::item:selected {
    background-color: #3a2d7a;
    border-color: #6d4aff;
    color: white;
}

/*  ==========================================================================
    Tooltips and the Properties window's server table: drawn here so they
    look the same under every Qt style, Fusion (the AppImage's) included.
    ========================================================================== */

QToolTip {
    background-color: #25253d;
    color: #eaeaea;
    border: 1px solid #3a3a55;
    padding: 4px 6px;
}

QTableWidget#serverTable {
    background-color: #25253d;
    alternate-background-color: #2a2a45;
    color: #eaeaea;
    border: 1px solid #3a3a55;
    border-radius: 6px;
    selection-background-color: #3a335d;
    selection-color: #eaeaea;
    outline: none;
}
QTableWidget#serverTable::item {
    padding: 0px 8px;
    border: none;
}
QTableWidget#serverTable QHeaderView {
    background-color: transparent;
}
QTableWidget#serverTable QHeaderView::section {
    background-color: #1f1f35;
    color: #9999bb;
    border: none;
    border-right: 1px solid #3a3a55;
    border-bottom: 1px solid #3a3a55;
    /* Room at the right for the sort arrow SortArrowHeader draws. */
    padding: 6px 22px 6px 8px;
    font-weight: bold;
}
QTableWidget#serverTable QHeaderView::section:last {
    border-right: none;
}
/* Where the two scroll bars meet: left to the table's own rounded frame, as
   Breeze does, not a panel drawn over it, as Fusion (the AppImage's style)
   does. */
QTableWidget#serverTable::corner {
    background: transparent;
    border: none;
}
QTableWidget#serverTable QTableCornerButton::section {
    background-color: #1f1f35;
    border: none;
}
