<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/assets">
        <file alias="proton-vpn-logo.svg">assets/proton-vpn-logo.svg</file>
        <file alias="proton-vpn-logo-light.svg">assets/proton-vpn-logo-light.svg</file>
        <file alias="proton-vpn-sign.svg">assets/proton-vpn-sign.svg</file>
        <file alias="state-connected.svg">assets/state-connected.svg</file>
        <file alias="state-disconnected.svg">assets/state-disconnected.svg</file>
        <file alias="state-connecting.svg">assets/state-connecting.svg</file>
        <file alias="state-error.svg">assets/state-error.svg</file>
        <file alias="maintenance-icon.svg">assets/maintenance-icon.svg</file>
        <file alias="no-app-icon.svg">assets/no-app-icon.svg</file>
        <file alias="security-key.svg">assets/security-key.svg</file>
        <file alias="security-key-light.svg">assets/security-key-light.svg</file>
        <file alias="lock-fill.svg">assets/lock-fill.svg</file>
        <file alias="person-lines-fill.svg">assets/person-lines-fill.svg</file>
        <file alias="power.svg">assets/power.svg</file>
        <file alias="gear.svg">assets/gear.svg</file>
        <file alias="eye-hide.svg">assets/eye/hide.svg</file>
        <file alias="eye-show.svg">assets/eye/show.svg</file>
        <file alias="chevron-up.svg">assets/chevron-up.svg</file>
        <file alias="chevron-down.svg">assets/chevron-down.svg</file>
        <file alias="chevron-down-light.svg">assets/chevron-down-light.svg</file>
        <file alias="check-white.svg">assets/check-white.svg</file>
        <file alias="server-p2p.svg">assets/servers/p2p.svg</file>
        <file alias="server-secure-core.svg">assets/servers/secure-core.svg</file>
        <file alias="server-smart-routing.svg">assets/servers/smart-routing.svg</file>
        <file alias="server-streaming.svg">assets/servers/streaming.svg</file>
        <file alias="server-tor.svg">assets/servers/tor.svg</file>
        <file alias="clipboard2-plus.svg">assets/clipboard2-plus.svg</file>
        <file alias="bug.svg">assets/bug.svg</file>
        <file alias="star.svg">assets/star.svg</file>
        <file alias="star-fill.svg">assets/star-fill.svg</file>
        <file alias="arrow-bar-right.svg">assets/arrow-bar-right.svg</file>
        <file alias="arrow-bar-left.svg">assets/arrow-bar-left.svg</file>
        <file alias="box-arrow-up-right.svg">assets/box-arrow-up-right.svg</file>
    </qresource>
    <qresource prefix="/globe">
        <file alias="land.png">assets/globe/land.png</file>
        <file alias="country_centers.json">assets/globe/country_centers.json</file>
    </qresource>
    <qresource prefix="/">
        <file>version.json</file>
        <file>style.qss</file>
        <file>style_light.qss</file>
    </qresource>
    <qresource prefix="/autostart">
        <file alias="proton-vpn-qt.desktop">autostart/proton-vpn-qt.desktop</file>
    </qresource>
</RCC>

