QWidget {
    background-color: #f0f0f5;
    color: #1a1a2e;
    font-family: "Inter", "Noto Sans", "Segoe UI", sans-serif;
    font-size: 13px;
}

QLabel {
    background-color: transparent;
}

QWidget#sidebar {
    background-color: #e2e2ec;
    border-right: 1px solid #c8c8d8;
    padding: 0;
}

QFrame#sidebarDivider {
    color: #c8c8d8;
}

QToolButton#navButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px;
}
QToolButton#navButton:hover {
    background-color: #d0d0e0;
}
QToolButton#navButton:checked {
    background-color: #c0b0f0;
}

QToolButton#logoButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 8px;
}
QToolButton#logoButton:hover {
    background-color: #d0d0e0;
}
QToolButton#logoButton:checked {
    background-color: #c0b0f0;
}

QWidget#loginCard {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #c8c8d8;
}

QLabel#sectionTitle {
    font-size: 18px;
    font-weight: bold;
    color: #1a1a2e;
}

QLabel#fieldLabel {
    color: #5a5a7a;
    font-size: 12px;
}

QLabel#errorLabel,
QAbstractScrollArea#errorLabel {
    color: #c0392b;
    background-color: rgba(192, 57, 43, 0.08);
    border: 1px solid #c0392b;
    border-radius: 6px;
    padding: 8px;
}

QLabel#timerLabel {
    font-size: 16px;
    color: #5a5a7a;
    font-family: "Courier New", "DejaVu Sans Mono", monospace;
}

QLabel#infoLabel {
    color: #5a5a7a;
    font-size: 12px;
}

QLabel#signOutHintLabel {
    color: #8a6800;
    font-size: 12px;
    background-color: rgba(200, 160, 0, 0.08);
    border: 1px solid rgba(200, 160, 0, 0.35);
    border-radius: 6px;
    padding: 8px 12px;
}

QLineEdit#inputField {
    background-color: #ffffff;
    border: 1px solid #c8c8d8;
    border-radius: 6px;
    padding: 8px 12px;
    color: #1a1a2e;
    selection-background-color: #6d4aff;
}
QLineEdit#inputField:focus {
    border-color: #6d4aff;
}

QFrame#locationPicker {
    background-color: transparent;
}
QFrame#locationPickerHeader {
    background-color: #ffffff;
    border: 1px solid #c8c8d8;
    border-radius: 8px;
}
QFrame#locationPickerHeader:hover {
    border-color: #6d4aff;
}
QLabel#locationPickerTop {
    color: #5a5a7a;
    font-size: 10px;
}
QLabel#locationPickerBottom {
    color: #1a1a2e;
    font-size: 13px;
    font-weight: bold;
}
QLabel#locationPickerChevron {
    color: #5a5a7a;
    font-size: 12px;
}
QFrame#locationPickerPopup {
    background-color: #ffffff;
    border: 1px solid #c8c8d8;
    border-top: none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
QListWidget#locationPickerList {
    background-color: transparent;
    border: none;
    outline: none;
}
QListWidget#locationPickerList::item {
    border-bottom: 1px solid #e0e0ec;
}
QListWidget#locationPickerList::item:selected,
QListWidget#locationPickerList::item:selected:!active {
    background-color: #e0d8ff;
}
QListWidget#locationPickerList::item:hover {
    background-color: #ececf8;
}
/*  Picker dropdown row under the mouse (PickerBase::setHoveredRow). Matches the
    row only, never the labels and buttons inside it, so the translucent color
    is painted once.  */
QListWidget#locationPickerList QWidget[hovered="true"] {
    background-color: rgba(109, 74, 255, 60);
}

/*  Countries page: the "Fastest server" row at the top of a city list  */
QWidget#cityRow[fastest="true"] {
    background-color: rgba(109, 74, 255, 40);
}

QLabel#locationPickerItemLabel {
    color: #1a1a2e;
    font-size: 13px;
}

QPushButton#primaryButton {
    background-color: #6d4aff;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 24px;
    font-weight: bold;
    font-size: 14px;
    min-width: 140px;
}
QPushButton#primaryButton:hover {
    background-color: #5a3de0;
}
QPushButton#primaryButton:disabled {
    background-color: #c8c8d8;
    color: #9090a8;
}

/*  Also applied to the buttons Qt creates inside standard dialogs
    (QMessageBox, QDialogButtonBox), which the app cannot give an object
    name; without a rule they would be drawn by the native style.  */
QPushButton#secondaryButton,
QDialogButtonBox QPushButton {
    background-color: transparent;
    color: #5a5a7a;
    border: 1px solid #c8c8d8;
    border-radius: 6px;
    padding: 4px 12px;
}
QPushButton#secondaryButton:hover,
QDialogButtonBox QPushButton:hover {
    background-color: #e0e0ec;
    color: #1a1a2e;
}

/*  Main button of a dialog (Close, Got It!, Download). Mirrors how Breeze
    draws a dialog's default button, so builds running under Fusion (the
    AppImage) look the same. A standard dialog's default button gets it too.  */
QPushButton#dialogButton,
QDialogButtonBox QPushButton:default {
    background-color: rgba(109, 74, 255, 0.15);
    color: palette(button-text);
    border: 1px solid #9a84fd;
    border-radius: 4px;
    padding: 4px 12px;
}
QPushButton#dialogButton:hover,
QDialogButtonBox QPushButton:default:hover {
    background-color: rgba(109, 74, 255, 0.25);
    border-color: #6d4aff;
}
QPushButton#dialogButton:pressed,
QDialogButtonBox QPushButton:default:pressed {
    background-color: rgba(109, 74, 255, 0.35);
}

QDialogButtonBox QPushButton {
    min-width: 64px;
}

/*  No stock icons (Fusion's check mark on OK, for one) on the buttons of
    standard dialogs: Breeze draws none, and the AppImage, which runs under
    Fusion, should look the same.  */
QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}

/* Floating overlay variant – same look as secondaryButton but with a solid
   page-color background so content scrolling underneath is hidden. */
QPushButton#refreshOverlayButton {
    background-color: #f0f0f5;
    color: #5a5a7a;
    border: 1px solid #c8c8d8;
    border-radius: 6px;
    padding: 4px 12px;
}
QPushButton#refreshOverlayButton:hover {
    background-color: #e0e0ec;
    color: #1a1a2e;
}
QPushButton#refreshOverlayButton:disabled {
    color: #a0a0b8;
    border-color: #d8d8e8;
}

QPushButton#leaveVpnOnButton {
    background-color: transparent;
    color: palette(window-text);
    border: 1px solid palette(window-text);
    border-radius: 6px;
    padding: 4px 12px;
}
QPushButton#leaveVpnOnButton:hover {
    background-color: rgba(0, 0, 0, 0.07);
}

QPushButton#dangerButton {
    background-color: transparent;
    color: #c0392b;
    border: 1px solid #c0392b;
    border-radius: 6px;
    padding: 10px 24px;
    font-weight: bold;
}
QPushButton#dangerButton:hover {
    background-color: rgba(192, 57, 43, 0.10);
}

QPushButton#iconButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
}
QPushButton#iconButton:hover {
    background-color: #dcdcec;
}

QToolButton#starButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
}
QToolButton#starButton:hover {
    background-color: #dcdcec;
    border: 1px solid #6d4aff;
    border-radius: 3px;
}

QListWidget#serverList {
    background-color: #ffffff;
    border: 1px solid #c8c8d8;
    border-radius: 6px;
    outline: none;
}
QListWidget#serverList::item {
    padding: 8px 12px;
    border-bottom: 1px solid #e8e8f0;
}
QListWidget#serverList::item:selected {
    background-color: #d8ccff;
    color: #1a1a2e;
}
QListWidget#serverList::item:hover {
    background-color: #ececf8;
}

QLabel#listHeader {
    font-size: 12px;
    font-weight: bold;
    color: #5a5a7a;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 0;
}

QWidget#infoCard {
    background-color: #ffffff;
    border-radius: 8px;
    border: 1px solid #c8c8d8;
}

QWidget#infoRow {
    background-color: transparent;
}

QLabel#infoKey {
    color: #5a5a7a;
}

QLabel#infoValue {
    color: #1a1a2e;
    font-weight: bold;
}

/*  Painted here instead of by the Qt style, so the line looks the same under
    Breeze (native builds, Flatpak) and Fusion (AppImage). The color is what
    Breeze drew for "color: #c8c8d8": 20% of it over the #f0f0f5 window. The
    window-colored top and bottom borders keep the line 1px thick in the
    middle of the 3px frame.  */
QFrame#divider {
    border: none;
    border-top: 1px solid #f0f0f5;
    border-bottom: 1px solid #f0f0f5;
    background-color: #e8e8ef;
}

QSplitter::handle {
    background-color: #c8c8d8;
    width: 1px;
}

QToolButton#accordionHeader {
    background-color: #f0f0f5;
    border: none;
    border-bottom: 1px solid #e0e0ec;
    color: #1a1a2e;
    text-align: left;
    padding: 0 12px;
    font-size: 13px;
}
QToolButton#accordionHeader:hover {
    background-color: #e4e4f0;
}

/* QScrollArea's internal viewport widget doesn't inherit the app's palette
   the way a normal QWidget does under Fusion, so it falls back to the
   style's own default rendering unless given an explicit background. */
QScrollArea {
    background: transparent;
    border: none;
}
QScrollArea > QWidget {
    background: transparent;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: #ffffff;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #b8b8cc;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #6d4aff;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QFrame#numberSpinner {
    background-color: #ffffff;
    border: 1px solid #c8c8d8;
    border-radius: 6px;
}
QFrame#numberSpinnerButtons {
    background-color: transparent;
    border-left: 1px solid #c8c8d8;
}
QLineEdit#numberSpinnerDisplay {
    background-color: transparent;
    color: #1a1a2e;
    border: none;
    padding: 2px 4px;
    selection-background-color: #6d4aff;
}
QPushButton#numberSpinnerBtnUp,
QPushButton#numberSpinnerBtnDown {
    background-color: #e8e8f4;
    border: none;
    padding: 0;
    margin: 0;
    min-height: 0;
}
QPushButton#numberSpinnerBtnUp {
    border-top-right-radius: 5px;
}
QPushButton#numberSpinnerBtnDown {
    border-bottom-right-radius: 5px;
}
QPushButton#numberSpinnerBtnUp:hover,
QPushButton#numberSpinnerBtnDown:hover {
    background-color: #c8c8d8;
}
QPushButton#numberSpinnerBtnUp:disabled,
QPushButton#numberSpinnerBtnDown:disabled {
    background-color: #f0f0f5;
}

QFrame#toastNotification {
    background-color: #e8f8ee;
    border: 1px solid #5cb87a;
    border-radius: 8px;
}
QFrame#toastNotification QLabel {
    color: #2d6a4f;
    background: transparent;
    border: none;
}
QPushButton#toastCloseBtn {
    color: #2d6a4f;
    background: transparent;
    border: none;
    font-weight: bold;
}
QPushButton#toastCloseBtn:hover {
    color: #1a4030;
}

QLabel#upgradeLabel {
    color: #5a5a7a;
    font-size: 9pt;
    padding: 4px 0px;
}
QLabel#upgradeLabel a {
    color: #6d4aff;
}

/*  Plus Members Only divider (VPN settings tab)  */
QLabel#plusDividerLabel {
    color: #6d4aff;
    font-size: 9pt;
    font-weight: bold;
    background-color: transparent;
}
/*  Painted like QFrame#divider, for the same reason  */
QFrame#plusDividerLine {
    border: none;
    border-top: 1px solid #f0f0f5;
    border-bottom: 1px solid #f0f0f5;
    background-color: #e8e8ef;
}

/*  App-tab section headers  */
QLabel#appSectionHeader {
    color: #4a3a9a;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1.5px;
    background-color: transparent;
}
QFrame#appSectionDivider {
    color: #c8c8dc;
    background-color: #c8c8dc;
    max-height: 1px;
    border: none;
    margin: 8px 0px 0px 0px;
}

/*  About nav row (clickable settings-style row)  */
QWidget#appNavRow:hover {
    background-color: #e0e0ec;
    border-radius: 8px;
}
/* Make child QWidgets transparent so the hover background shows through */
QWidget#appNavRow QWidget {
    background-color: transparent;
}

/*  Forwarded-port button group  */
QLabel#portValueLabel {
    border: 1px solid palette(mid);
    border-right: none;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
    background: transparent;
    padding: 4px 12px;
    font-weight: bold;
}
QPushButton#portCopyBtn {
    border: 1px solid palette(mid);
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    background: transparent;
    padding: 0px;
}
QPushButton#portCopyBtn:hover {
    border-color: palette(highlight);
    background: rgba(0,0,0,20);
}
QPushButton#portCopyBtn:pressed {
    background: rgba(0,0,0,40);
}

/*  Picker Drawer  */
QFrame#pickerDrawer {
    background-color: #f0f0f8;
    border-top: 1px solid #c0c0d8;
    border-right: 1px solid #c0c0d8;
    border-top-right-radius: 8px;
}

QFrame#drawerNotch {
    background-color: #e0e0f0;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border: 1px solid #c0c0d8;
    border-left: none;
}

QFrame#drawerNotch:hover {
    background-color: #d0d0e8;
}

/*  Tabs (Settings page): Fusion has no built-in Breeze-like tab rendering,
    so this is defined explicitly rather than left to the active QStyle. */
QTabWidget::pane {
    background-color: #f0f0f5;
    border: 1px solid #c8c8d8;
    border-radius: 6px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    top: -1px;
}
QTabWidget::tab-bar {
    left: 0px;
    alignment: left;
}
QTabBar::tab {
    background-color: transparent;
    color: #5a5a7a;
    border: none;
    padding: 6px 16px 5px 16px;
}
QTabBar::tab:selected {
    background-color: #f0f0f5;
    color: #1a1a2e;
    font-weight: bold;
    border: 1px solid #c8c8d8;
    border-bottom: none;
    border-top: 2px solid #6d4aff;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 4px 15px 5px 15px;
}
QTabBar::tab:hover:!selected {
    background-color: #dcdcec;
    color: #1a1a2e;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QComboBox {
    background-color: #ffffff;
    color: #1a1a2e;
    border: 1px solid #c8c8d8;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 22px;
    combobox-popup: 0;
}
QComboBox:hover {
    border-color: #6d4aff;
}
QComboBox:focus {
    border: 1px solid #6d4aff;
}
/*  The popup and its items are drawn entirely by these rules (combo boxes get
    a QStyledItemDelegate, see SettingsPage::makeComboBox()), so they look the
    same under Breeze (native builds, Flatpak) and Fusion (AppImage). They copy
    Breeze's look: 30px items with a rounded, outlined highlight. Breeze's first
    item is 1px taller, hence the extra top padding, and the -1px item padding
    lines the text up with Breeze's.  */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1a1a2e;
    border: 1px solid #c8c8d8;
    border-radius: 6px;
    outline: none;
    padding: 5px 4px 4px 4px;
}
QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 0px 0px 0px -1px;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #1a1a2e;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #d2cbe4;
    border-color: #7862ae;
    color: #1a1a2e;
}
QComboBox:disabled {
    color: #aaaabb;
    background-color: #e0e0ea;
    border-color: #c0c0d0;
}
QComboBox::drop-down {
    background: transparent;
    border: none;
}
QComboBox::drop-down:disabled {
    background: transparent;
    border: none;
}
QComboBox::down-arrow {
    image: url(:/assets/chevron-down.svg);
    width: 12px;
    height: 12px;
}
QComboBox::down-arrow:disabled {
    image: url(:/assets/chevron-down.svg);
    width: 12px;
    height: 12px;
    opacity: 0.3;
}

/*  ==========================================================================
    Colors that used to live in inline setStyleSheet() calls in C++.
    Same rules as style.qss, retuned for contrast against a light background.
    ========================================================================== */

/*  VPN status label - color follows the "vpnState" dynamic property  */
QLabel#vpnStatusLabel {
    font-size: 16pt;
    font-weight: bold;
    letter-spacing: 1px;
    color: #5a5a7a;
}
QLabel#vpnStatusLabel[vpnState="connected"]     { color: #14794a; }
QLabel#vpnStatusLabel[vpnState="disconnected"]  { color: #6b6b7b; }
QLabel#vpnStatusLabel[vpnState="transitioning"] { color: #a8690a; }
QLabel#vpnStatusLabel[vpnState="error"]         { color: #b3302f; }

/*  Secondary description text under a setting name  */
QLabel#settingsDesc                  { color: #6a6a78; }
QLabel#settingsDesc[disabled="true"] { color: #a8a8b4; }
QLabel#infoKey[disabled="true"]      { color: #9a9aa6; }

/*  Accent rows: "Fastest server" entries and picker actions  */
QLabel#locationPickerItemLabel[fastest="true"] { color: #6d4aff; }
QLabel#cityLabel[fastest="true"] { color: #6d4aff; background-color: transparent; }
QLabel#locationPickerItemLabel[action="true"] { color: #6a6a78; }

/*  Location picker dimmed for free accounts (no location choice)  */
QLabel#locationPickerTop[dimmed="true"],
QLabel#locationPickerBottom[dimmed="true"] { color: #a0a0b0; }

/*  Account plan value  */
QLabel#infoValue[plan="free"] { color: #6a6a78; font-weight: normal; }
QLabel#infoValue[plan="plus"] { color: #6d4aff; font-weight: bold; }

/*  ==========================================================================
    VPN page background globe
    ========================================================================== */

/*  Every plain container on the VPN page lets the globe show through. Widgets
    with background rules of their own (pickers, drawer, banners, buttons) keep
    them: those rules are more specific than this one.  */
VpnPage QWidget {
    background-color: transparent;
}

/*  Text over the globe sits on a partly transparent backdrop to stay legible.  */
QLabel#vpnStatusLabel,
QLabel#timerLabel,
QLabel#infoLabel {
    background-color: rgba(240, 240, 245, 0.72);
    border-radius: 8px;
    padding: 2px 12px;
}
QLabel#infoLabel[empty="true"] {
    background-color: transparent;
}
